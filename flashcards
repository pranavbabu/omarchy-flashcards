#!/usr/bin/env python3
"""Spaced-repetition flashcards: Anki-style scheduler, SQLite store, TTS audio.

All commands print one JSON document on stdout, so the Quickshell widget and
the tests read the same output. Standard library only.

Data lives in $FLASHCARDS_HOME (default ~/.local/share/omarchy-flashcards).
"""
import argparse
import csv
import hashlib
import html
import io
import re
import tempfile
import zipfile
import json
import os
import shutil
import sqlite3
import subprocess
import sys
import time
import urllib.parse
import urllib.request

HOME = os.environ.get("FLASHCARDS_HOME") or os.path.expanduser("~/.local/share/omarchy-flashcards")
DB_PATH = os.path.join(HOME, "cards.db")
AUDIO_DIR = os.path.join(HOME, "audio")
IMAGE_DIR = os.path.join(HOME, "images")

NEW, LEARNING, REVIEW, RELEARNING = 0, 1, 2, 3
AGAIN, HARD, GOOD, EASY = 1, 2, 3, 4

DAY = 86400
LEARN_STEPS = [60, 600]          # seconds: 1 min, 10 min (Anki defaults)
RELEARN_STEPS = [600]
GRADUATE_DAYS = 1
EASY_DAYS = 4
START_EASE = 2500                # permille
MIN_EASE = 1300
HARD_FACTOR = 1.2
EASY_BONUS = 1.3
LEARN_AHEAD = 20 * 60
DEFAULT_NEW_PER_DAY = 20

SCHEMA = """
CREATE TABLE IF NOT EXISTS decks (name TEXT PRIMARY KEY, lang TEXT NOT NULL);
CREATE TABLE IF NOT EXISTS meta (key TEXT PRIMARY KEY, value TEXT NOT NULL);
CREATE TABLE IF NOT EXISTS cards (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  deck TEXT NOT NULL,
  front TEXT NOT NULL,
  back TEXT NOT NULL,
  note TEXT NOT NULL DEFAULT '',
  audio TEXT NOT NULL DEFAULT '',
  state INTEGER NOT NULL DEFAULT 0,
  step INTEGER NOT NULL DEFAULT 0,
  due INTEGER NOT NULL DEFAULT 0,
  interval INTEGER NOT NULL DEFAULT 0,
  ease INTEGER NOT NULL DEFAULT 2500,
  reps INTEGER NOT NULL DEFAULT 0,
  lapses INTEGER NOT NULL DEFAULT 0,
  suspended INTEGER NOT NULL DEFAULT 0,
  created INTEGER NOT NULL,
  rank INTEGER,
  image TEXT NOT NULL DEFAULT '',
  image_mode TEXT NOT NULL DEFAULT '',
  UNIQUE (deck, front)
);
CREATE INDEX IF NOT EXISTS cards_due ON cards (suspended, state, due);
CREATE TABLE IF NOT EXISTS revlog (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  card_id INTEGER NOT NULL,
  ts INTEGER NOT NULL,
  rating INTEGER NOT NULL,
  state_before INTEGER NOT NULL,
  snapshot TEXT NOT NULL
);
"""
CARD_COLS = ("id", "deck", "front", "back", "note", "audio", "state", "step", "due",
             "interval", "ease", "reps", "lapses", "suspended", "created", "rank", "image", "image_mode")


class CliError(Exception):
    pass


def connect():
    os.makedirs(HOME, exist_ok=True)
    db = sqlite3.connect(DB_PATH)
    db.row_factory = sqlite3.Row
    db.executescript(SCHEMA)
    have = {r["name"] for r in db.execute("PRAGMA table_info(cards)")}
    for column, ddl in (("rank", "INTEGER"), ("image", "TEXT NOT NULL DEFAULT ''"), ("image_mode", "TEXT NOT NULL DEFAULT ''")):
        if column not in have:
            db.execute("ALTER TABLE cards ADD COLUMN %s %s" % (column, ddl))
    return db


def row_dict(row):
    return {k: row[k] for k in CARD_COLS}


# --- scheduler -------------------------------------------------------------

def _steps(state):
    return RELEARN_STEPS if state == RELEARNING else LEARN_STEPS


def _hard_delay(steps, step):
    if len(steps) == 1:
        return int(steps[0] * 1.5)
    return (steps[0] + steps[1]) // 2 if step == 0 else steps[step]


def schedule(card, rating, now):
    """Return the card's fields after answering `rating`. Pure function."""
    c = dict(card)
    state, step = c["state"], c["step"]
    c["reps"] += 1

    if state in (NEW, LEARNING, RELEARNING):
        steps = _steps(LEARNING if state == NEW else state)
        if state == NEW:
            state, step = LEARNING, 0
        if rating == AGAIN:
            c.update(state=state, step=0, due=now + steps[0])
        elif rating == HARD:
            c.update(state=state, step=step, due=now + _hard_delay(steps, step))
        elif rating == GOOD:
            if step + 1 < len(steps):
                c.update(state=state, step=step + 1, due=now + steps[step + 1])
            else:
                _graduate(c, now, max(c["interval"], GRADUATE_DAYS) if state == RELEARNING else GRADUATE_DAYS)
        else:
            _graduate(c, now, max(c["interval"] + 1, EASY_DAYS) if state == RELEARNING else EASY_DAYS)
        return c

    ivl, ease = max(c["interval"], 1), c["ease"]
    if rating == AGAIN:
        c.update(state=RELEARNING, step=0, due=now + RELEARN_STEPS[0], lapses=c["lapses"] + 1,
                 ease=max(MIN_EASE, ease - 200), interval=max(1, ivl // 2))
        return c
    # Keep the three passing intervals strictly increasing, as Anki does.
    hard = max(int(round(ivl * HARD_FACTOR)), ivl + 1)
    good = max(int(round(ivl * ease / 1000)), hard + 1)
    easy = max(int(round(ivl * ease / 1000 * EASY_BONUS)), good + 1)
    days, new_ease = {HARD: (hard, max(MIN_EASE, ease - 150)), GOOD: (good, ease), EASY: (easy, ease + 150)}[rating]
    c.update(state=REVIEW, step=0, interval=days, ease=new_ease, due=now + days * DAY)
    return c


def _graduate(c, now, days):
    c.update(state=REVIEW, step=0, interval=days, due=now + days * DAY,
             ease=c["ease"] or START_EASE)


def fmt_interval(seconds):
    s = max(0, seconds)
    if s < 60:
        return "<1m"
    if s < 3600:
        return "%dm" % round(s / 60)
    if s < DAY:
        return "%dh" % round(s / 3600)
    d = s / DAY
    if d < 30:
        return "%dd" % round(d)
    if d < 365:
        return "%.1fmo" % (d / 30)
    return "%.1fy" % (d / 365)


# --- queue -------------------------------------------------------------------

def day_start(now):
    t = time.localtime(now)
    return int(time.mktime((t.tm_year, t.tm_mon, t.tm_mday, 0, 0, 0, 0, 0, -1)))


def deck_names(db, deck):
    return [deck] if deck else [r[0] for r in db.execute("SELECT name FROM decks ORDER BY name")]


def new_budget(db, now, limit, deck):
    """New cards still allowed today in one deck; each deck has its own daily limit."""
    seen = db.execute("SELECT COUNT(*) FROM revlog r JOIN cards c ON c.id = r.card_id "
                      "WHERE r.state_before = ? AND r.ts >= ? AND c.deck = ?",
                      (NEW, day_start(now), deck)).fetchone()[0]
    return max(0, limit - seen)


def counts(db, now, deck, limit):
    where, args = ("AND deck = ?", [deck]) if deck else ("", [])
    q = lambda extra, a: db.execute(
        "SELECT COUNT(*) FROM cards WHERE suspended = 0 %s %s" % (where, extra), args + a).fetchone()[0]
    new_count = 0
    for name in deck_names(db, deck):
        total = db.execute("SELECT COUNT(*) FROM cards WHERE suspended = 0 AND state = ? AND deck = ?",
                           (NEW, name)).fetchone()[0]
        new_count += min(total, new_budget(db, now, limit, name))
    return {
        "new": new_count,
        "learning": q("AND state IN (?, ?) AND due <= ?", [LEARNING, RELEARNING, now]),
        "review": q("AND state = ? AND due <= ?", [REVIEW, now]),
    }


def pick_queue(db, now, deck, limit, count):
    """Up to `count` cards in study order: learning, then reviews, then new, then learn-ahead."""
    where, args = ("AND deck = ?", [deck]) if deck else ("", [])
    rows = []

    def take(extra, a, cap):
        if cap <= 0:
            return
        rows.extend(db.execute(
            "SELECT * FROM cards WHERE suspended = 0 %s %s LIMIT ?" % (where, extra), args + a + [cap]).fetchall())

    take("AND state IN (?, ?) AND due <= ? ORDER BY due", [LEARNING, RELEARNING, now], count)
    take("AND state = ? AND due <= ? ORDER BY due", [REVIEW, now], count - len(rows))
    for name in deck_names(db, deck):
        room = min(count - len(rows), new_budget(db, now, limit, name))
        if room > 0:
            rows.extend(db.execute("SELECT * FROM cards WHERE suspended = 0 AND state = ? AND deck = ? ORDER BY id LIMIT ?",
                                   (NEW, name, room)).fetchall())
    if not rows:
        take("AND state IN (?, ?) AND due <= ? ORDER BY due", [LEARNING, RELEARNING, now + LEARN_AHEAD], count)
    return rows


def next_due_in(db, now, deck):
    where, args = ("AND deck = ?", [deck]) if deck else ("", [])
    row = db.execute("SELECT MIN(due) FROM cards WHERE suspended = 0 AND state != ? %s" % where,
                     [NEW] + args).fetchone()[0]
    return None if row is None else max(0, row - now)


def lang_of(db, deck):
    row = db.execute("SELECT lang FROM decks WHERE name = ?", (deck,)).fetchone()
    return row["lang"] if row else "no"


# --- commands ------------------------------------------------------------------

def cmd_next(a, db, now):
    limit = a.new_per_day
    rows = pick_queue(db, now, a.deck, limit, max(1, a.count))
    out = {"card": None, "cards": [], "counts": counts(db, now, a.deck, limit),
           "total": db.execute("SELECT COUNT(*) FROM cards").fetchone()[0],
           "next_due_in": next_due_in(db, now, a.deck)}
    for row in rows:
        card = row_dict(row)
        card["lang"] = lang_of(db, card["deck"])
        card["preview"] = {str(r): fmt_interval(preview_delay(card, r, now)) for r in (AGAIN, HARD, GOOD, EASY)}
        out["cards"].append(card)
    out["card"] = out["cards"][0] if out["cards"] else None
    where, args = ("AND deck = ?", [a.deck]) if a.deck else ("", [])
    out["new_waiting"] = db.execute("SELECT COUNT(*) FROM cards WHERE suspended = 0 AND state = ? %s" % where,
                                    [NEW] + args).fetchone()[0]
    out["due"] = sum(out["counts"].values())
    return out


def preview_delay(card, rating, now):
    return schedule(card, rating, now)["due"] - now


def cmd_answer(a, db, now):
    row = db.execute("SELECT * FROM cards WHERE id = ?", (a.id,)).fetchone()
    if not row:
        raise CliError("no card with id %d" % a.id)
    card = row_dict(row)
    new = schedule(card, a.rating, now)
    db.execute("INSERT INTO revlog (card_id, ts, rating, state_before, snapshot) VALUES (?,?,?,?,?)",
               (card["id"], now, a.rating, card["state"], json.dumps(card)))
    db.execute("UPDATE cards SET state=?, step=?, due=?, interval=?, ease=?, reps=?, lapses=? WHERE id=?",
               (new["state"], new["step"], new["due"], new["interval"], new["ease"],
                new["reps"], new["lapses"], card["id"]))
    return {"ok": True, "id": card["id"], "due_in": new["due"] - now, "interval": new["interval"]}


def cmd_undo(a, db, now):
    row = db.execute("SELECT * FROM revlog ORDER BY id DESC LIMIT 1").fetchone()
    if not row:
        raise CliError("nothing to undo")
    s = json.loads(row["snapshot"])
    db.execute("UPDATE cards SET state=?, step=?, due=?, interval=?, ease=?, reps=?, lapses=? WHERE id=?",
               (s["state"], s["step"], s["due"], s["interval"], s["ease"], s["reps"], s["lapses"], s["id"]))
    db.execute("DELETE FROM revlog WHERE id = ?", (row["id"],))
    return {"ok": True, "id": s["id"]}


def ensure_deck(db, deck, lang):
    db.execute("INSERT OR IGNORE INTO decks (name, lang) VALUES (?, ?)", (deck, lang))
    if lang:
        db.execute("UPDATE decks SET lang = ? WHERE name = ?", (lang, deck))


def insert_card(db, deck, front, back, note, audio, now, rank=None, image="", image_mode=""):
    cur = db.execute(
        "INSERT OR IGNORE INTO cards (deck, front, back, note, audio, ease, created, rank, image, image_mode) "
        "VALUES (?,?,?,?,?,?,?,?,?,?)",
        (deck, front.strip(), back.strip(), note.strip(), audio.strip(), START_EASE, now, rank, image, image_mode))
    if not cur.rowcount and rank is not None:
        db.execute("UPDATE cards SET rank = ? WHERE deck = ? AND front = ? AND rank IS NULL",
                   (rank, deck, front.strip()))
    return cur.lastrowid if cur.rowcount else None


def cmd_add(a, db, now):
    if not a.front.strip() or not a.back.strip():
        raise CliError("front and back must not be empty")
    ensure_deck(db, a.deck, a.lang)
    image = os.path.expanduser(a.image)
    if image and not os.path.isfile(image):
        raise CliError("image not found: %s" % image)
    cid = insert_card(db, a.deck, a.front, a.back, a.note, a.audio, now, image=image, image_mode="front" if image else "")
    if cid is None:
        raise CliError("'%s' is already in deck %s" % (a.front.strip(), a.deck))
    return {"ok": True, "id": cid}


def _zstd(data):
    try:
        from compression import zstd  # Python 3.14+
    except ImportError:
        raise CliError("this Anki export is zstd-compressed: use Python 3.14+ or export with 'Support older Anki versions'")
    return zstd.decompress(data)


def _varint(buf, i):
    n = shift = 0
    while True:
        b = buf[i]
        i += 1
        n |= (b & 0x7F) << shift
        if b < 0x80:
            return n, i
        shift += 7


def _media_names(raw):
    """Map zip member name -> media file name, from legacy JSON or the newer protobuf list."""
    try:
        return json.loads(raw.decode("utf-8"))
    except (UnicodeDecodeError, ValueError):
        pass
    buf, i, names = _zstd(raw), 0, {}
    while i < len(buf):
        tag, i = _varint(buf, i)
        size, i = _varint(buf, i)
        entry, i = buf[i:i + size], i + size
        j, name = 0, ""
        while j < len(entry):
            etag, j = _varint(entry, j)
            if etag & 7 == 2:
                size, j = _varint(entry, j)
                if etag >> 3 == 1:
                    name = entry[j:j + size].decode("utf-8")
                j += size
            else:
                _, j = _varint(entry, j)
        names[str(len(names))] = name
    return names


def _plain(text):
    text = re.sub(r"\[sound:[^\]]*\]", "", text)
    text = re.sub(r"<\s*(br|/div|/p)\s*/?>", " ", text, flags=re.I)
    return re.sub(r"\s+", " ", html.unescape(re.sub(r"<[^>]+>", "", text))).strip()


def _models(col):
    """Return {model id: [field names in order]} for old and new collection layouts."""
    tables = {r[0] for r in col.execute("SELECT name FROM sqlite_master WHERE type = 'table'")}
    if "fields" in tables:
        out = {}
        for ntid, name in col.execute("SELECT ntid, name FROM fields ORDER BY ntid, ord"):
            out.setdefault(ntid, []).append(name)
        return out
    raw = col.execute("SELECT models FROM col").fetchone()[0]
    return {int(k): [f["name"] for f in m["flds"]] for k, m in json.loads(raw).items()}


def _pick(names, include, exclude=()):
    """Index of the first field whose name matches `include` and not `exclude`."""
    for i, n in enumerate(names):
        low = n.lower()
        if re.search(include, low) and not any(re.search(x, low) for x in exclude):
            return i
    return None


def _resolve(names, spec, include, exclude=()):
    """Field index from a user spec (name or 1-based number), else by name heuristics."""
    if spec:
        if spec.isdigit() and 1 <= int(spec) <= len(names):
            return int(spec) - 1
        for i, n in enumerate(names):
            if n.lower() == spec.lower():
                return i
        raise CliError("no field '%s'. Fields: %s" % (spec, ", ".join(names)))
    return _pick(names, include, exclude)


NOISE = (r"audio", r"ipa", r"example", r"index", r"class", r"inflect", r"dictionary", r"sound", r"article")


IMG_RE = re.compile(r"""<img[^>]*?\ssrc\s*=\s*(?:"([^"]*)"|'([^']*)'|([^\s>]+))""", re.I)


def _images(text):
    return [html.unescape(next(g for g in m.groups() if g is not None)) for m in IMG_RE.finditer(text)]


def read_apkg(path, front=None, back=None, note=None):
    """Yield (front, back, note, sound, media, rank, image_name, image_bytes, image_mode) per note."""
    with zipfile.ZipFile(path) as z:
        members = set(z.namelist())
        raw = next((n for n in ("collection.anki21b", "collection.anki21", "collection.anki2") if n in members), None)
        if raw is None:
            raise CliError("not an Anki package: no collection found")
        blob = z.read(raw)
        if raw.endswith("21b"):
            blob = _zstd(blob)
        names = _media_names(z.read("media")) if "media" in members else {}
        by_name = {v: k for k, v in names.items()}
        with tempfile.TemporaryDirectory() as tmp:
            dbfile = os.path.join(tmp, "c.db")
            with open(dbfile, "wb") as fh:
                fh.write(blob)
            col = sqlite3.connect(dbfile)
            models = _models(col)
            rows = col.execute("SELECT mid, flds FROM notes ORDER BY id").fetchall()
            col.close()
        plans = {}
        for mid, flds in rows:
            fields = flds.split("\x1f")
            fnames = models.get(mid) or ["Field %d" % (i + 1) for i in range(len(fields))]
            if mid not in plans:
                f = _resolve(fnames, front, r"word|front|term|expression|question", NOISE)
                b = _resolve(fnames, back, r"translation|meaning|back|english|answer|definition", (r"general", r"audio", r"nuance"))
                n = _resolve(fnames, note, r"example|sentence")
                f = 0 if f is None else f
                b = (1 if len(fnames) > 1 and f == 0 else 0) if b is None else b
                plans[mid] = (f, b, n,
                              None if front else _pick(fnames, r"^article"), _pick(fnames, r"word class|part of speech|^pos$"),
                              [i for i, x in enumerate(fnames) if re.search(r"audio|sound|pronunc", x.lower())
                               and "example" not in x.lower() and "container" not in x.lower()],
                              _pick(fnames, r"frequency|rank"))
            f, b, n, art, cls, audio_fields, rk = plans[mid]
            fields += [""] * len(fnames)
            word = _plain(fields[f])
            if art is not None and _plain(fields[art]):
                word = _plain(fields[art]) + " " + word
            meaning = _plain(fields[b])
            if cls is not None and _plain(fields[cls]) and meaning:
                meaning += " (" + _plain(fields[cls]) + ")"
            sound = next((m for i in audio_fields for m in re.findall(r"\[sound:([^\]]+)\]", fields[i])), None)
            sound = sound or next(iter(re.findall(r"\[sound:([^\]]+)\]", flds)), None)
            media = z.read(by_name[sound]) if sound in by_name else None
            rank = _plain(fields[rk]) if rk is not None else ""
            image, image_bytes, image_mode = None, None, ""
            for field_index in (f, b, *range(len(fnames))):
                found = next((i for i in _images(fields[field_index]) if i in by_name or urllib.parse.unquote(i) in by_name), None)
                if found:
                    image = found if found in by_name else urllib.parse.unquote(found)
                    image_bytes = z.read(by_name[image])
                    image_mode = "front" if field_index == f else "answer"
                    break
            if image and not word and meaning:
                word, meaning, image_mode = meaning, "", "prompt"
            yield (word, meaning, _plain(fields[n]) if n is not None else "", sound, media,
                   int(rank) if rank.isdigit() else None, image, image_bytes, image_mode)


def import_apkg(a, db, now):
    ensure_deck(db, a.deck, a.lang)
    added = skipped = 0
    for front, back, note, sound, media, rank, image_name, image_bytes, image_mode in read_apkg(a.file, a.front, a.back, a.note):
        image = ""
        if image_bytes:
            image = os.path.join(IMAGE_DIR, hashlib.sha1(image_bytes).hexdigest()[:12] + "-" + re.sub(r"[^\w.-]", "_", image_name))
            os.makedirs(IMAGE_DIR, exist_ok=True)
            if not os.path.isfile(image):
                with open(image, "wb") as fh:
                    fh.write(image_bytes)
        audio = ""
        if media:
            audio = os.path.join(AUDIO_DIR, "anki", re.sub(r"[^\w.-]", "_", sound))
            os.makedirs(os.path.dirname(audio), exist_ok=True)
            with open(audio, "wb") as fh:
                fh.write(media)
        if not front or (not back and image_mode != "prompt") or insert_card(
                db, a.deck, front, back, note, audio, now, rank, image, image_mode if image else "") is None:
            skipped += 1
        else:
            added += 1
    return {"ok": True, "added": added, "skipped": skipped}


def cmd_import(a, db, now):
    if not os.path.isfile(a.file):
        raise CliError("file not found: %s" % a.file)
    if a.file.lower().endswith(".apkg"):
        try:
            return import_apkg(a, db, now)
        except (zipfile.BadZipFile, sqlite3.DatabaseError):
            raise CliError("not a valid Anki package: %s" % a.file)
    with open(a.file, encoding="utf-8-sig", newline="") as fh:
        lines = [l for l in fh.read().splitlines() if l.strip() and not l.startswith("#")]
    if not lines:
        return {"ok": True, "added": 0, "skipped": 0}
    delim = "\t" if "\t" in lines[0] else (";" if lines[0].count(";") > lines[0].count(",") else ",")
    ensure_deck(db, a.deck, a.lang)
    added = skipped = 0
    for cols in csv.reader(lines, delimiter=delim):
        cols = [c.strip() for c in cols] + ["", "", "", ""]
        if not cols[0] or not cols[1]:
            skipped += 1
        elif insert_card(db, a.deck, cols[0], cols[1], cols[2], cols[3], now) is None:
            skipped += 1
        else:
            added += 1
    return {"ok": True, "added": added, "skipped": skipped}


def _tokens(text):
    return re.findall(r"[^\W\d_]+", text.lower())


def cmd_skip_easy(a, db, now):
    """Suspend new cards made only of the `max_rank` most frequent words (a proxy for CEFR A1)."""
    ranked = db.execute("SELECT front FROM cards WHERE rank IS NOT NULL AND rank <= ?", (a.max_rank,)).fetchall()
    if not ranked:
        raise CliError("no ranked cards: import a frequency deck first")
    easy = {t for r in ranked for t in _tokens(r["front"])}
    victims = []
    for r in db.execute("SELECT id, front, rank FROM cards WHERE state = ? AND suspended = 0", (NEW,)):
        words = _tokens(r["front"])
        if (r["rank"] is not None and r["rank"] <= a.max_rank) or (r["rank"] is None and words and all(w in easy for w in words)):
            victims.append(r)
    if not a.dry_run:
        db.executemany("UPDATE cards SET suspended = 1 WHERE id = ?", [(v["id"],) for v in victims])
    return {"ok": True, "dry_run": a.dry_run, "suspended": len(victims),
            "sample": [v["front"] for v in victims[:: max(1, len(victims) // 25)]][:25]}


def cmd_unsuspend(a, db, now):
    cur = db.execute("UPDATE cards SET suspended = 0 WHERE suspended = 1")
    return {"ok": True, "restored": cur.rowcount}


def get_meta(db, key):
    row = db.execute("SELECT value FROM meta WHERE key = ?", (key,)).fetchone()
    return row["value"] if row else None


def cmd_decks(a, db, now):
    out = []
    for d in db.execute("SELECT name, lang FROM decks ORDER BY name"):
        c = counts(db, now, d["name"], a.new_per_day)
        n = db.execute("SELECT COUNT(*), COALESCE(SUM(suspended), 0) FROM cards WHERE deck = ?", (d["name"],)).fetchone()
        out.append({"name": d["name"], "lang": d["lang"], "total": n[0], "suspended": n[1], **c})
    return {"decks": out, "active": get_meta(db, "deck")}


def cmd_use_deck(a, db, now):
    if a.name != "*" and not db.execute("SELECT 1 FROM decks WHERE name = ?", (a.name,)).fetchone():
        raise CliError("no deck named %s" % a.name)
    db.execute("INSERT OR REPLACE INTO meta (key, value) VALUES ('deck', ?)", (a.name,))
    return {"ok": True}


def cmd_delete_deck(a, db, now):
    ids = [r[0] for r in db.execute("SELECT id FROM cards WHERE deck = ?", (a.name,))]
    if not ids and not db.execute("SELECT 1 FROM decks WHERE name = ?", (a.name,)).fetchone():
        raise CliError("no deck named %s" % a.name)
    db.executemany("DELETE FROM revlog WHERE card_id = ?", [(i,) for i in ids])
    db.execute("DELETE FROM cards WHERE deck = ?", (a.name,))
    db.execute("DELETE FROM decks WHERE name = ?", (a.name,))
    if get_meta(db, "deck") == a.name:
        db.execute("DELETE FROM meta WHERE key = 'deck'")
    return {"ok": True, "deleted": len(ids)}


def cmd_rename_deck(a, db, now):
    if not db.execute("SELECT 1 FROM decks WHERE name = ?", (a.old,)).fetchone():
        raise CliError("no deck named %s" % a.old)
    if db.execute("SELECT 1 FROM decks WHERE name = ?", (a.new,)).fetchone():
        raise CliError("a deck named %s already exists" % a.new)
    db.execute("UPDATE decks SET name = ? WHERE name = ?", (a.new, a.old))
    db.execute("UPDATE cards SET deck = ? WHERE deck = ?", (a.new, a.old))
    db.execute("UPDATE meta SET value = ? WHERE key = 'deck' AND value = ?", (a.new, a.old))
    return {"ok": True}


def cmd_find_files(a, db, now):
    import glob
    found = []
    for pattern in ("*.apkg", "*.tsv", "*.csv", "*.txt"):
        found += glob.glob(os.path.join(os.path.expanduser(a.dir), pattern))
    found.sort(key=os.path.getmtime, reverse=True)
    return {"files": [{"name": os.path.basename(p), "path": p, "mb": round(os.path.getsize(p) / 1e6, 1)}
                      for p in found[:8]]}


def cmd_list(a, db, now):
    q = "%" + (a.query or "") + "%"
    rows = db.execute("SELECT * FROM cards WHERE (front LIKE ? OR back LIKE ?) ORDER BY id DESC LIMIT ?",
                      (q, q, a.limit)).fetchall()
    return {"cards": [row_dict(r) for r in rows]}


def cmd_delete(a, db, now):
    cur = db.execute("DELETE FROM cards WHERE id = ?", (a.id,))
    if not cur.rowcount:
        raise CliError("no card with id %d" % a.id)
    return {"ok": True}


def cmd_stats(a, db, now):
    by_state = {r["state"]: r["n"] for r in db.execute("SELECT state, COUNT(*) AS n FROM cards WHERE suspended = 0 GROUP BY state")}
    suspended = db.execute("SELECT COUNT(*) FROM cards WHERE suspended = 1").fetchone()[0]
    today = db.execute("SELECT COUNT(*), COALESCE(SUM(rating > 1), 0) FROM revlog WHERE ts >= ?",
                       (day_start(now),)).fetchone()
    mature = db.execute("SELECT COUNT(*) FROM cards WHERE state = ? AND interval >= 21", (REVIEW,)).fetchone()[0]
    return {"total": sum(by_state.values()) + suspended, "suspended": suspended, "new": by_state.get(NEW, 0),
            "learning": by_state.get(LEARNING, 0) + by_state.get(RELEARNING, 0),
            "review": by_state.get(REVIEW, 0), "mature": mature,
            "reviewed_today": today[0], "passed_today": today[1]}


# --- audio -----------------------------------------------------------------------

ESPEAK_VOICE = {"no": "nb", "nb": "nb", "nn": "nb"}


def audio_path(card, lang):
    if card["audio"]:
        return os.path.expanduser(card["audio"])
    key = hashlib.sha1(("%s\0%s" % (lang, card["front"])).encode()).hexdigest()[:20]
    return os.path.join(AUDIO_DIR, "%s-%s.mp3" % (lang, key))


def fetch_tts(text, lang, dest):
    url = "https://translate.google.com/translate_tts?" + urllib.parse.urlencode(
        {"ie": "UTF-8", "client": "tw-ob", "tl": lang, "q": text[:200]})
    req = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0"})
    with urllib.request.urlopen(req, timeout=15) as resp:
        data = resp.read()
    if len(data) < 200:
        raise CliError("text-to-speech returned no audio")
    os.makedirs(os.path.dirname(dest), exist_ok=True)
    tmp = dest + ".part"
    with open(tmp, "wb") as fh:
        fh.write(data)
    os.replace(tmp, dest)


def play(path):
    for cmd in (["mpv", "--no-video", "--really-quiet", path], ["ffplay", "-nodisp", "-autoexit", "-loglevel", "quiet", path]):
        if shutil.which(cmd[0]):
            subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL, start_new_session=True)
            return True
    return False


def ensure_audio(card, lang):
    """Return a playable file path, or None when only live speech synthesis is possible."""
    path = audio_path(card, lang)
    if os.path.isfile(path):
        return path
    if card["audio"]:
        raise CliError("audio file not found: %s" % path)
    try:
        fetch_tts(card["front"], lang, path)
        return path
    except (OSError, CliError):
        return None


def cmd_audio(a, db, now):
    row = db.execute("SELECT * FROM cards WHERE id = ?", (a.id,)).fetchone()
    if not row:
        raise CliError("no card with id %d" % a.id)
    card = row_dict(row)
    lang = lang_of(db, card["deck"])
    path = ensure_audio(card, lang)
    if path is None:
        voice = ESPEAK_VOICE.get(lang, lang)
        if not shutil.which("espeak-ng"):
            raise CliError("no audio: offline and espeak-ng is not installed")
        if a.play:
            subprocess.Popen(["espeak-ng", "-v", voice, card["front"]], start_new_session=True,
                             stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return {"ok": True, "path": None, "engine": "espeak-ng"}
    if a.play and not play(path):
        raise CliError("no audio player found (install mpv)")
    return {"ok": True, "path": path, "engine": "file" if card["audio"] else "tts"}


def cmd_prefetch(a, db, now):
    done = 0
    for row in db.execute("SELECT * FROM cards WHERE audio = ''").fetchall():
        card = row_dict(row)
        if not os.path.isfile(audio_path(card, lang_of(db, card["deck"]))):
            if ensure_audio(card, lang_of(db, card["deck"])):
                done += 1
    return {"ok": True, "fetched": done}


# --- entry point ----------------------------------------------------------------------

def build_parser():
    p = argparse.ArgumentParser(prog="flashcards", description=__doc__)
    p.add_argument("--now", type=int, default=None, help=argparse.SUPPRESS)
    sub = p.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("next", help="next cards due, with counts and answer previews")
    s.add_argument("--deck")
    s.add_argument("--new-per-day", type=int, default=DEFAULT_NEW_PER_DAY)
    s.add_argument("--count", type=int, default=1, help="how many upcoming cards to return")
    s.set_defaults(fn=cmd_next)

    s = sub.add_parser("answer", help="record an answer: 1 again, 2 hard, 3 good, 4 easy")
    s.add_argument("id", type=int)
    s.add_argument("rating", type=int, choices=(1, 2, 3, 4))
    s.set_defaults(fn=cmd_answer)

    sub.add_parser("undo", help="undo the last answer").set_defaults(fn=cmd_undo)

    s = sub.add_parser("add", help="add one card")
    s.add_argument("front")
    s.add_argument("back")
    s.add_argument("--note", default="")
    s.add_argument("--audio", default="", help="path to your own audio file")
    s.add_argument("--image", default="", help="path to a picture shown with the card")
    s.add_argument("--deck", default="Norwegian")
    s.add_argument("--lang", default="no", help="speech language code, e.g. no, sv, de")
    s.set_defaults(fn=cmd_add)

    s = sub.add_parser("import", help="import an Anki .apkg, or a TSV/CSV file: front, back, note, audio")
    s.add_argument("file")
    s.add_argument("--deck", default="Norwegian")
    s.add_argument("--lang", default="no")
    s.add_argument("--no-prefetch", action="store_true")
    for part in ("front", "back", "note"):
        s.add_argument("--" + part, help="Anki field for the %s: a field name or its 1-based number" % part)
    s.set_defaults(fn=cmd_import)

    s = sub.add_parser("list", help="search cards")
    s.add_argument("query", nargs="?", default="")
    s.add_argument("--limit", type=int, default=50)
    s.set_defaults(fn=cmd_list)

    s = sub.add_parser("delete")
    s.add_argument("id", type=int)
    s.set_defaults(fn=cmd_delete)

    s = sub.add_parser("skip-easy", help="suspend new cards that only use the most frequent words")
    s.add_argument("--max-rank", type=int, default=800, help="words up to this frequency rank count as easy")
    s.add_argument("--dry-run", action="store_true")
    s.set_defaults(fn=cmd_skip_easy)

    s = sub.add_parser("decks", help="list decks with counts and the active deck")
    s.add_argument("--new-per-day", type=int, default=DEFAULT_NEW_PER_DAY)
    s.set_defaults(fn=cmd_decks)

    s = sub.add_parser("use-deck", help="choose the deck to study; '*' studies every deck")
    s.add_argument("name")
    s.set_defaults(fn=cmd_use_deck)

    s = sub.add_parser("delete-deck", help="delete a deck and all of its cards")
    s.add_argument("name")
    s.set_defaults(fn=cmd_delete_deck)

    s = sub.add_parser("rename-deck")
    s.add_argument("old")
    s.add_argument("new")
    s.set_defaults(fn=cmd_rename_deck)

    s = sub.add_parser("find-files", help="list importable files in a folder")
    s.add_argument("--dir", default="~/Downloads")
    s.set_defaults(fn=cmd_find_files)

    sub.add_parser("unsuspend", help="bring back every suspended card").set_defaults(fn=cmd_unsuspend)

    sub.add_parser("stats").set_defaults(fn=cmd_stats)

    s = sub.add_parser("audio", help="fetch pronunciation audio for a card, optionally play it")
    s.add_argument("id", type=int)
    s.add_argument("--play", action="store_true")
    s.set_defaults(fn=cmd_audio)

    sub.add_parser("prefetch", help="download audio for every card").set_defaults(fn=cmd_prefetch)
    return p


def main(argv=None):
    a = build_parser().parse_args(argv)
    now = a.now if a.now is not None else int(time.time())
    db = connect()
    try:
        with db:
            out = a.fn(a, db, now)
        if a.cmd == "import" and not a.no_prefetch and out["added"]:
            subprocess.Popen([sys.executable, os.path.abspath(__file__), "prefetch"], start_new_session=True,
                             stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except CliError as e:
        print(json.dumps({"ok": False, "error": str(e)}))
        return 1
    print(json.dumps(out, ensure_ascii=False))
    return 0


if __name__ == "__main__":
    sys.exit(main())
