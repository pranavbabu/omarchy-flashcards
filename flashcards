#!/bin/sh
# Runs the compiled backend, or says how to build it. The panel shows this message.
dir=$(cd "$(dirname "$0")" && pwd -P)
bin="$dir/target/release/flashcards"
if [ ! -x "$bin" ]; then
  printf '{"ok": false, "error": "Backend not built. Run: cargo build --release (in %s)"}\n' "$dir"
  exit 1
fi
exec "$bin" "$@"
